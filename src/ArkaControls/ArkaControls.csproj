<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ArkaControls</RootNamespace>
    <AssemblyName>ArkaControls</AssemblyName>

    <!-- NuGet -->
    <PackageId>ArkaControls</PackageId>
    <Version>0.1.0</Version>
    <Authors>DataHub Software</Authors>
    <Company>DataHub Software</Company>
    <Product>ArkaControls</Product>
    <Copyright>Copyright (c) 2026 DataHub Software</Copyright>
    <PackageProjectUrl>https://github.com/DataHub-Software/ArkaControls</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DataHub-Software/ArkaControls</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Description>Flat, rounded-corner Windows Forms controls (button, panel, text box, combo box, label, toggle switch, separator) with full designer support and a data grid theme. Apache-2.0 licensed.</Description>
    <PackageTags>winforms;controls;ui;rounded;flat;designer</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArkaControls.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
